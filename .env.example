# Capital.com API
CAPITAL_API_KEY=your_api_key_here
CAPITAL_EMAIL=your_email@example.com
CAPITAL_PASSWORD=your_api_key_password
CAPITAL_DEMO=true

# Database
DATABASE_URL=postgresql://microprofits:microprofits_dev@db:5432/microprofits
POSTGRES_PASSWORD=microprofits_dev

# Optional: specify account ID (leave empty for default/preferred)
CAPITAL_ACCOUNT_ID=

# X/Twitter API (for headline scraping — get from developer.x.com)
X_BEARER_TOKEN=

# Discord webhook (bias signal notifications)
DISCORD_WEBHOOK_URL=
